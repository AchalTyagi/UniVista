# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Long random secret used to sign UniVista JWTs
JWT_SECRET=replace_with_a_long_random_secret

# Public Vercel deployment origin (no trailing slash)
FRONTEND_URL=https://univista-eta.vercel.app
BACKEND_URL=https://univista-eta.vercel.app

# OAuth credentials (create these in Google Cloud and GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
